{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
    'helpers:pinGitHubActionDigests',
  ],
  schedule: [
    // At 05:00AM on day-of-month 1 and 15
    '* 5 1,15 * *',
  ],
  configMigration: true,
  rebaseWhen: 'behind-base-branch',
  // Hold every update until its release is three days old: a compromised release is
  // usually caught and yanked within that window, before it reaches the lock file.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    // Through a pull request, so the main ruleset's required checks run on the new
    // lock file before it merges. Renovate holds no bypass on main.
    automergeType: 'pr',
  },
  enabledManagers: [
    // pyproject.toml and uv.lock
    'pep621',
    // .github/workflows/*.yml
    'github-actions',
    // .github/pre-commit-config.yaml
    'pre-commit',
  ],
  // The pre-commit manager is opt-in, and this repository keeps its config under
  // .github/ instead of the repository root, so both have to be stated.
  'pre-commit': {
    enabled: true,
    managerFilePatterns: [
      '/^\\.github/pre-commit-config\\.ya?ml$/',
    ],
  },
  ignoreDeps: [
    // Ignore python: pep621 reads `requires-python` as a dependency, but the
    // >=3.12 floor is a deliberate support decision, not something to bump on a
    // release of the interpreter.
    'python',
  ],
}
